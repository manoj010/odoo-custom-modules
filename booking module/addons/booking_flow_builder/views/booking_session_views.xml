<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_booking_session_list" model="ir.ui.view">
        <field name="name">booking.session.list</field>
        <field name="model">booking.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="flow_id"/>
                <field name="partner_id"/>
                <field name="total_price"/>
                <field name="state"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="view_booking_session_form" model="ir.ui.view">
        <field name="name">booking.session.form</field>
        <field name="model">booking.session</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="customer_phone"/>
                            <field name="customer_note"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Booking">
                            <field name="flow_id"/>
                            <field name="state"/>
                            <field name="current_step_id"/>
                            <field name="booking_datetime"/>
                            <field name="currency_id"/>
                            <field name="total_price"/>
                            <field name="sale_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Answers">
                            <field name="answer_ids">
                                <list editable="bottom">
                                    <field name="step_id"/>
                                    <field name="option_id"/>
                                    <field name="text_value"/>
                                    <field name="numeric_value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_booking_session" model="ir.actions.act_window">
        <field name="name">All Sessions</field>
        <field name="res_model">booking.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
