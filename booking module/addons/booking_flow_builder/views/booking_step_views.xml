<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_booking_step_list" model="ir.ui.view">
        <field name="name">booking.flow.step.list</field>
        <field name="model">booking.flow.step</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="flow_id"/>
                <field name="title"/>
                <field name="step_type"/>
                <field name="required"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_booking_step_form" model="ir.ui.view">
        <field name="name">booking.flow.step.form</field>
        <field name="model">booking.flow.step</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="flow_id"/>
                            <field name="title"/>
                            <field name="subtitle"/>
                            <field name="step_type"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="required"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Options">
                            <field name="option_ids" context="{'default_step_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="pricing_type"/>
                                    <field name="pricing_value"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_booking_option_form" model="ir.ui.view">
        <field name="name">booking.flow.option.form</field>
        <field name="model">booking.flow.option</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="step_id"/>
                            <field name="label"/>
                            <field name="image" widget="image"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="pricing_type"/>
                            <field name="pricing_value"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
