<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_booking_flow_public_active" model="ir.rule">
        <field name="name">Public active booking flows</field>
        <field name="model_id" ref="model_booking_flow"/>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_booking_step_public_active" model="ir.rule">
        <field name="name">Public active booking steps</field>
        <field name="model_id" ref="model_booking_flow_step"/>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="domain_force">[('active', '=', True), ('flow_id.active', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_booking_option_public_active" model="ir.rule">
        <field name="name">Public active booking options</field>
        <field name="model_id" ref="model_booking_flow_option"/>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="domain_force">[('active', '=', True), ('step_id.active', '=', True), ('step_id.flow_id.active', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_booking_session_public_own_create" model="ir.rule">
        <field name="name">Public create booking sessions</field>
        <field name="model_id" ref="model_booking_session"/>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_booking_answer_public_create" model="ir.rule">
        <field name="name">Public create booking answers</field>
        <field name="model_id" ref="model_booking_session_answer"/>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
