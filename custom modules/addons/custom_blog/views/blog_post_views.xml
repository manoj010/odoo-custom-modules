<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blog_post_tree" model="ir.ui.view">
        <field name="name">custom_blog.post.tree</field>
        <field name="model">custom_blog.post</field>
        <field name="arch" type="xml">
            <list string="Blog Posts">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_blog_post_form" model="ir.ui.view">
        <field name="name">custom_blog.post.form</field>
        <field name="model">custom_blog.post</field>
        <field name="arch" type="xml">
            <form string="Blog Post">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Title..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="image_position" widget="radio" options="{'horizontal': true}"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="content" widget="html" options="{'snippets': 'web_editor.snippets'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_blog_post_search" model="ir.ui.view">
        <field name="name">custom_blog.post.search</field>
        <field name="model">custom_blog.post</field>
        <field name="arch" type="xml">
            <search string="Search Blog Posts">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_blog_post" model="ir.actions.act_window">
        <field name="name">Blog Posts</field>
        <field name="res_model">custom_blog.post</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_blog_post_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new blog post
            </p>
        </field>
    </record>
</odoo>
