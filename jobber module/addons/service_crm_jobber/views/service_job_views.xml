<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_service_job_list" model="ir.ui.view">
        <field name="name">service.job.list</field>
        <field name="model">service.job</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'completed'" decoration-danger="status in ['late', 'cancelled']">
                <field name="partner_id" string="Client"/>
                <field name="sequence" string="Job Number"/>
                <field name="property_address" string="Property"/>
                <field name="scheduled_date" string="Schedule"/>
                <field name="status" widget="badge"/>
                <field name="total_amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_service_job_form" model="ir.ui.view">
        <field name="name">service.job.form</field>
        <field name="model">service.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="status not in ['unscheduled', 'late']"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="status not in ['upcoming', 'today', 'action_required']"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="status != 'requires_invoicing'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="status in ['completed', 'cancelled']"/>
                    <field name="status" widget="statusbar" statusbar_visible="unscheduled,upcoming,today,requires_invoicing,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sequence" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="quote_id"/>
                            <field name="request_id"/>
                            <field name="job_type"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="assigned_user_id"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <field name="property_address"/>
                    <field name="visit_instructions"/>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_name"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_amount" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_service_job_kanban" model="ir.ui.view">
        <field name="name">service.job.kanban</field>
        <field name="model">service.job</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_service_crm_kanban">
                <field name="sequence"/>
                <field name="partner_id"/>
                <field name="scheduled_date"/>
                <field name="total_amount"/>
                <field name="currency_id"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_service_crm_card o_service_crm_card_job">
                            <div class="o_service_crm_card_top">
                                <strong><field name="sequence"/></strong>
                                <span class="o_service_crm_badge"><field name="status"/></span>
                            </div>
                            <div class="o_service_crm_card_title"><field name="partner_id"/></div>
                            <small><field name="scheduled_date"/></small>
                            <div><field name="total_amount" widget="monetary"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_service_job_calendar" model="ir.ui.view">
        <field name="name">service.job.calendar</field>
        <field name="model">service.job</field>
        <field name="arch" type="xml">
            <calendar string="Schedule" date_start="scheduled_date" color="assigned_user_id">
                <field name="partner_id"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="action_service_job" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">service.job</field>
        <field name="view_mode">kanban,list,calendar,form</field>
    </record>
</odoo>
