<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_service_invoice_list" model="ir.ui.view">
        <field name="name">service.invoice.list</field>
        <field name="model">service.invoice</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'paid'" decoration-danger="status in ['past_due', 'bad_debt']">
                <field name="partner_id" string="Client"/>
                <field name="sequence" string="Invoice Number"/>
                <field name="due_date"/>
                <field name="job_id" string="Subject"/>
                <field name="status" widget="badge"/>
                <field name="total_amount" widget="monetary"/>
                <field name="balance_amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_service_invoice_form" model="ir.ui.view">
        <field name="name">service.invoice.form</field>
        <field name="model">service.invoice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Send" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid" class="btn-primary" invisible="status == 'paid'"/>
                    <button name="action_mark_bad_debt" type="object" string="Bad Debt" invisible="status in ['paid', 'bad_debt']"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,awaiting_payment,past_due,paid,bad_debt"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sequence" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="job_id"/>
                            <field name="quote_id"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                            <field name="payment_terms"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_name"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="subtotal" readonly="1"/>
                                <field name="discount"/>
                                <field name="tax_amount" readonly="1"/>
                                <field name="total_amount" readonly="1"/>
                                <field name="balance_amount" readonly="1"/>
                            </group>
                        </page>
                        <page string="Messages">
                            <field name="client_message"/>
                            <field name="internal_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_service_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">service.invoice</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
