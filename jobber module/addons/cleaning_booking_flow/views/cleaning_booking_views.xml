<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cleaning_booking_service_view_tree" model="ir.ui.view">
        <field name="name">cleaning.booking.service.list</field>
        <field name="model">cleaning.booking.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="price"/>
                <field name="duration_minutes"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="cleaning_booking_service_view_form" model="ir.ui.view">
        <field name="name">cleaning.booking.service.form</field>
        <field name="model">cleaning.booking.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="icon_class"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="duration_minutes"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cleaning_booking_service_action" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">cleaning.booking.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="cleaning_booking_view_tree" model="ir.ui.view">
        <field name="name">cleaning.booking.list</field>
        <field name="model">cleaning.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="customer_name"/>
                <field name="service_id"/>
                <field name="booking_date"/>
                <field name="booking_time"/>
                <field name="price"/>
                <field name="payment_status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="cleaning_booking_view_form" model="ir.ui.view">
        <field name="name">cleaning.booking.form</field>
        <field name="model">cleaning.booking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="service_id"/>
                            <field name="customer_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="booking_date"/>
                            <field name="booking_time"/>
                            <field name="price"/>
                            <field name="payment_status"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message">
                            <field name="message"/>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cleaning_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">cleaning.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="cleaning_booking_menu_root" name="Cleaning Booking" sequence="30"/>
    <menuitem id="cleaning_booking_menu_bookings" name="Bookings" parent="cleaning_booking_menu_root" action="cleaning_booking_action" sequence="10"/>
    <menuitem id="cleaning_booking_menu_services" name="Services" parent="cleaning_booking_menu_root" action="cleaning_booking_service_action" sequence="20"/>
</odoo>
