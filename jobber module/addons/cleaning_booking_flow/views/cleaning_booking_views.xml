<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════
         SERVICE OPTIONS (appointment.type)
    ═══════════════════════════════════════════ -->
    <record id="cleaning_booking_service_view_tree" model="ir.ui.view">
        <field name="name">cleaning.booking.service.list</field>
        <field name="model">appointment.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="price"/>
                <field name="appointment_duration"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="cleaning_booking_service_view_form" model="ir.ui.view">
        <field name="name">cleaning.booking.service.form</field>
        <field name="model">appointment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="icon_class"/>
                            <field name="appointment_tz"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="appointment_duration" string="Duration (hr)"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cleaning_booking_service_action" model="ir.actions.act_window">
        <field name="name">Service Options</field>
        <field name="res_model">appointment.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('cleaning_booking_service_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('cleaning_booking_service_view_form')}),
        ]"/>
        <field name="context">{
            'active_test': False,
            'default_is_cleaning_service': True,
            'default_appointment_tz': 'UTC',
            'default_category': 'custom',
            'default_appointment_duration': 1.0
        }</field>
        <field name="domain">[('is_cleaning_service', '=', True)]</field>
    </record>

    <!-- ═══════════════════════════════════════════
         AVAILABILITY (cleaning.booking.availability)
    ═══════════════════════════════════════════ -->
    <record id="cleaning_booking_availability_view_tree" model="ir.ui.view">
        <field name="name">cleaning.booking.availability.list</field>
        <field name="model">cleaning.booking.availability</field>
        <field name="arch" type="xml">
            <list>
                <field name="service_id"/>
                <field name="weekday"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="slot_interval_minutes"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="cleaning_booking_availability_view_form" model="ir.ui.view">
        <field name="name">cleaning.booking.availability.form</field>
        <field name="model">cleaning.booking.availability</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="service_id"/>
                        <field name="weekday"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="slot_interval_minutes"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cleaning_booking_availability_action" model="ir.actions.act_window">
        <field name="name">Availability</field>
        <field name="res_model">cleaning.booking.availability</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════
         BOOKINGS (calendar.event)
    ═══════════════════════════════════════════ -->
    <record id="cleaning_booking_view_list" model="ir.ui.view">
        <field name="name">cleaning.booking.list</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="appointment_type_id" string="Service"/>
                <field name="partner_ids" widget="many2many_tags" string="Customer"/>
                <field name="start" string="Date &amp; Time"/>
                <field name="stop" string="Ends At"/>
                <field name="price"/>
                <field name="payment_status"/>
            </list>
        </field>
    </record>

    <record id="cleaning_booking_view_form" model="ir.ui.view">
        <field name="name">cleaning.booking.form</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Booking Info">
                            <field name="appointment_type_id" string="Service"/>
                            <field name="partner_ids" widget="many2many_tags" string="Customer"/>
                            <field name="location"/>
                        </group>
                        <group string="Schedule &amp; Payment">
                            <field name="start" string="Date &amp; Time"/>
                            <field name="stop" string="Ends At"/>
                            <field name="price"/>
                            <field name="payment_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cleaning_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('cleaning_booking_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('cleaning_booking_view_form')}),
        ]"/>
        <field name="domain">[('is_cleaning_booking', '=', True)]</field>
        <field name="context">{'default_is_cleaning_booking': True}</field>
    </record>

    <!-- ═══════════════════════════════════════════
         MENU
    ═══════════════════════════════════════════ -->
    <menuitem id="cleaning_booking_menu_root"
              name="Cleaning Booking"
              sequence="30"/>
    <menuitem id="cleaning_booking_menu_bookings"
              name="Bookings"
              parent="cleaning_booking_menu_root"
              action="cleaning_booking_action"
              sequence="10"/>
    <menuitem id="cleaning_booking_menu_services"
              name="Service Options"
              parent="cleaning_booking_menu_root"
              action="cleaning_booking_service_action"
              sequence="20"/>
    <menuitem id="cleaning_booking_menu_availability"
              name="Availability"
              parent="cleaning_booking_menu_root"
              action="cleaning_booking_availability_action"
              sequence="30"/>

</odoo>